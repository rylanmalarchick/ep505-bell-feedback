// Tang Nano 20K pins, from sipeed/TangNano-20K-example uart/src/top.cst
// (checked 2026-11-10): 27 MHz clock on pin 4, UART through the on-board
// debugger on pins 69 (FPGA tx) and 70 (FPGA rx).
IO_LOC "clk" 4;
IO_LOC "uart_rx" 70;
IO_LOC "uart_tx" 69;
IO_PORT "clk" IO_TYPE=LVCMOS33;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
